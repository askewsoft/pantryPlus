{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "noImplicitReturns": true,
    "baseUrl": ".",
    "paths": {
      "@/*": ["src/*"],
      "pantry-intents": ["modules/pantry-intents/index.ts"]
    },
    "esModuleInterop": true
  },
  "include": [
    "App.tsx",
    "src/**/*",
    "modules/pantry-intents/**/*",
    "scripts/**/*"
  ],
  "exclude": [
    "node_modules"
  ]
}
