{
  "name": "pantryplus",
  "version": "2.3.0",
  "scripts": {
    "start": "npx expo start --dev-client",
    "prebuild": "NODE_NO_WARNINGS=1 npx expo prebuild",
    "prebuild:clean": "NODE_NO_WARNINGS=1 npx expo prebuild --clean  # This will regenerate the native iOS files",
    "ios": "NODE_NO_WARNINGS=1 npx expo run:ios --device \"${IOS_SIM_DEVICE:-iPhone 17}\"",
    "android": "NODE_NO_WARNINGS=1 npx expo run:android",
    "dev:ios": "eas build --platform ios --profile development --clear-cache --local",
    "preview:ios": "eas build --platform ios --profile preview --clear-cache",
    "prod:ios": "eas build --platform ios --profile prod --clear-cache",
    "publish:ios": "eas submit --platform ios",
    "update:preview": "node scripts/update.js preview",
    "update:prod": "node scripts/update.js prod",
    "version:patch": "./scripts/version.sh patch",
    "version:minor": "./scripts/version.sh minor",
    "version:major": "./scripts/version.sh major",
    "killport": "sudo kill -9 $(sudo lsof -t -i :8081) # Do this if the Metro Bundler fails to start",
    "test:intents": "swift test --package-path plugins/withPantryIntents",
    "test:typeahead": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' src/utils/itemTypeahead.test.ts",
    "gettoken": "npx ts-node --compiler-options '{\"module\":\"commonjs\"}' scripts/get-token.ts",
    "expoupdate": "node scripts/update.js",
    "maestro": "./scripts/maestro-tests.sh --screenshots current",
    "maestro:current": "./scripts/maestro-tests.sh --screenshots current all",
    "maestro:baseline": "./scripts/maestro-tests.sh --screenshots baseline all",
    "postinstall": "patch-package"
  },
  "dependencies": {
    "@aws-amplify/react-native": "^1.1.6",
    "@aws-amplify/rtn-web-browser": "^1.1.1",
    "@aws-amplify/ui-react-native": "^2.2.16",
    "@expo/vector-icons": "^15.0.3",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/drawer": "^7.9.8",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/stack": "^7.8.10",
    "aws-amplify": "^6.6.7",
    "date-fns": "^4.1.0",
    "expo": "~58.0.26",
    "expo-application": "~58.1.2",
    "expo-asset": "~58.0.21",
    "expo-constants": "~58.0.16",
    "expo-crypto": "~58.0.8",
    "expo-dev-client": "~58.0.21",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-location": "~58.0.22",
    "expo-splash-screen": "~58.0.14",
    "expo-status-bar": "~58.0.5",
    "expo-updates": "~58.0.22",
    "metro": "^0.84.6",
    "mobx": "^6.13.5",
    "mobx-react": "^9.1.1",
    "mobx-state-tree": "^6.0.1",
    "mst-persist": "^0.1.4",
    "pantry-intents": "file:modules/pantry-intents",
    "pantryplus-api-client": "github:askewsoft/pantryPlusApiClient#v2.0.2",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-context-menu-view": "^1.19.0",
    "react-native-draggable-flatlist": "^4.0.1",
    "react-native-dropdown-picker": "^5.4.6",
    "react-native-gesture-handler": "~3.3.0",
    "react-native-get-random-values": "^1.11.0",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "~5.11.1",
    "react-native-screens": "~4.30.1",
    "react-native-swipeable-item": "^2.0.9",
    "react-native-worklets": "0.13.0"
  },
  "devDependencies": {
    "@aws-sdk/client-cognito-identity-provider": "^3.535.0",
    "@babel/core": "^7.20.0",
    "@types/react": "~19.3.0",
    "babel-preset-expo": "~58.0.0",
    "dotenv": "^16.4.5",
    "patch-package": "^8.0.1",
    "ts-node": "^10.9.2",
    "typescript": "~6.0.3"
  },
  "private": true,
  "expo": {
    "autolinking": {
      "nativeModulesDir": "./modules"
    }
  }
}
