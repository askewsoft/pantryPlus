# Copy to `.env` for local Expo, and/or `.env.preview` for scripts like `npm run gettoken`.
# Never commit real secrets. See docs/ENV_AND_SECRETS.md.

# API host without trailing /v2 (the app appends /v2)
EXPO_PUBLIC_API_URL=https://your-api-host.example.com

# AWS Cognito
EXPO_PUBLIC_USER_POOL_ID=us-east-1_xxxxxxxxx
EXPO_PUBLIC_APP_CLIENT_ID=xxxxxxxxxxxxxxxxxxxxxxxxxx
EXPO_PUBLIC_REGION=us-east-1

# Optional verbose client logging
EXPO_PUBLIC_DEBUG=false
